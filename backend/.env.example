# ============================================================
# CIPHER-SENTINEL Backend Environment Variables
# Copy this file to .env and fill in your actual values
# ============================================================

# --- Neon PostgreSQL ---
# Get from: https://console.neon.tech → your project → Connection string
# Use the asyncpg driver prefix (postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# --- Supabase ---
# Get from: https://supabase.com → your project → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...   # anon key
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # service_role key

# Storage bucket name (create this in Supabase Dashboard → Storage)
SUPABASE_BUCKET=cipher-sentinel-uploads

# --- JWT Secret ---
# IMPORTANT: Must match your Supabase project JWT secret
# Found at: Supabase Dashboard → Settings → API → JWT Secret
SECRET_KEY=your-supabase-jwt-secret-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
